# Public site URL (auth email links, Paystack callback, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. (Legacy name SUPABASE_SERVICE_ROLE_KEY also works.)
SUPABASE_SECRET_KEY=

# Paystack — Settings → API Keys & Webhooks. Use sk_test_… for test mode.
# Leave empty to use the built-in demo checkout (development only, or set PAYMENTS_DEMO=true).
PAYSTACK_SECRET_KEY=
PAYMENTS_DEMO=

# Shown after payment
NEXT_PUBLIC_WHATSAPP_INVITE_URL=

# Optional: free Google PageSpeed Insights API key (console.cloud.google.com → APIs →
# PageSpeed Insights API). Without it the speed tools fall back to a quick scan.
PAGESPEED_API_KEY=

# Development only: open the course at /learn without signing in (progress saved to .data/).
COURSE_PREVIEW=

# Admin: only these accounts (signed up and email-confirmed) can open /admin. Comma-separated.
ADMIN_EMAILS=

# Certificate emails via Resend (resend.com, free tier). EMAIL_FROM must use a domain
# verified in Resend, e.g. STEINARK <hello@yourdomain.com>.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: salt for the cookieless visitor hash (defaults to a value derived from the secret key).
ANALYTICS_SALT=
