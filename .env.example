# Public site URL (auth email links, Paystack callback, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. (Legacy name SUPABASE_SERVICE_ROLE_KEY also works.)
SUPABASE_SECRET_KEY=

# Paystack — Settings → API Keys & Webhooks. sk_test_… = Paystack test mode, sk_live_… = real money.
# Leave empty and checkout says payments aren't open (there is no simulated checkout).
PAYSTACK_SECRET_KEY=

# Shown after payment
NEXT_PUBLIC_WHATSAPP_INVITE_URL=

# Public support email shown on the privacy, terms and refund pages
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: free Google PageSpeed Insights API key (console.cloud.google.com → APIs →
# PageSpeed Insights API). Without it the speed tools fall back to a quick scan.
PAGESPEED_API_KEY=

# Optional: "Write it with AI" on 20 free tools (console.anthropic.com → API keys). Without it the
# button is hidden and the templates still work. Redeploy after setting: tool pages are static.
# Set a monthly spend limit in the Anthropic console too.
ANTHROPIC_API_KEY=
# Optional: model for the tools (default claude-opus-5-5; claude-sonnet-5-5 costs about half).
AI_TOOLS_MODEL=
# Optional: most AI writes per day across all visitors (default 300): the ceiling on spend.
AI_TOOLS_DAILY_LIMIT=

# Accounts that always have the Main Track without paying (e.g. your own production test
# account). Comma-separated; each must sign up and confirm its email like anyone else.
PERMANENT_STUDENT_EMAILS=

# Admin: only these accounts (signed up and email-confirmed) can open /admin. Comma-separated.
ADMIN_EMAILS=

# Certificate emails via Resend (resend.com, free tier). EMAIL_FROM must use a domain
# verified in Resend, e.g. Prostatis <hello@yourdomain.com>.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: salt for the cookieless visitor hash (defaults to a value derived from the secret key).
ANALYTICS_SALT=
